{
  "functions": [
    {
      "source": ".",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        ".env*",
        "serviceAccount*.json",
        "bruno",
        "tests",
        "docs"
      ]
    }
  ],
  "hosting": [
    {
      "target": "prod",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "function": {
            "functionId": "api",
            "region": "southamerica-east1"
          }
        }
      ]
    },
    {
      "target": "uat",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "function": {
            "functionId": "apiUat",
            "region": "southamerica-east1"
          }
        }
      ]
    }
  ]
}
