meta {
  name: Crear Alumno
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/alumnos
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Ana García",
    "email": "ana.garcia@ejemplo.com"
  }
}

tests {
  test("status code is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  if (res.body && res.body.id) {
    bru.setVar("alumnoId", res.body.id);
  }
}
