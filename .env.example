# Entorno de ejecución: development | test | uat | production
NODE_ENV=development
PYTHON_API_URL=http://localhost:8000
JWT_SECRET=cambiar_en_produccion
BCRYPT_SALT_ROUNDS=10

# ========================================================
# Configuración de Firebase / Cloud Firestore
# ========================================================
# Nota: Se utiliza el prefijo FB_ porque Firebase CLI reserva el prefijo FIREBASE_ y PORT para su infraestructura.

# ID del proyecto en Firebase Console
FB_PROJECT_ID=turnapp-node

# Base de datos de Firestore:
# - Desarrollo / Local: (default)
# - UAT: turnapp-uat
# - Producción: turnapp-prod
# FB_DATABASE_ID=(default)

# OPCIÓN 1: Desarrollo local / Tests con Emulador de Firestore
# FIRESTORE_EMULATOR_HOST=localhost:8080

# OPCIÓN 2: Conexión mediante archivo de Cuenta de Servicio (local / staging)
# FB_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# OPCIÓN 3: Conexión mediante JSON en variable de entorno (para CI/CD o hosting)
# FB_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"..."}'
