# Entorno de ejecución: development | test | uat | production
NODE_ENV=development
PORT=3000
PYTHON_API_URL=http://localhost:8000
JWT_SECRET=cambiar_en_produccion
BCRYPT_SALT_ROUNDS=10

# Configuración de Firebase / Cloud Firestore

# FIREBASE_PROJECT_ID=tp-prog4-dev

# OPCIÓN 1: Desarrollo local / Tests con Emulador de Firestore
# Si esta variable está activa, no se necesitan credenciales de Google
# FIRESTORE_EMULATOR_HOST=localhost:8080

# OPCIÓN 2: Conexión mediante archivo de Cuenta de Servicio (local / staging)
# Descargar desde: Firebase Console -> Configuración -> Cuentas de servicio -> Generar nueva clave
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# OPCIÓN 3: Conexión mediante JSON en variable de entorno (recomendado para CI/CD / Railway / Render)
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"..."}'
